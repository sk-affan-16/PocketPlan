<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp" android:paddingTop="24dp" android:paddingEnd="20dp" android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POCKETPLAN"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your finances"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_pp_dashboard_hero"
            android:padding="12dp"
            android:elevation="4dp">

            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:gravity="center_vertical">


                <TextView

                    android:layout_width="0dp"

                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:text="TOTAL AVAILABLE BALANCE"

                    android:textColor="#E8DFFF"

                    android:textSize="12sp"

                    android:textStyle="bold"

                    android:letterSpacing="0.08"/>


                <ImageView

                    android:layout_width="42dp"

                    android:layout_height="42dp"

                    android:src="@drawable/ic_wallet_white"

                    android:contentDescription="Wallet"

                    android:scaleType="fitCenter"/>


            </LinearLayout>

            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Γé╣0.00"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your money, clearly managed."
                android:textColor="#E8DFFF"
                android:textSize="13sp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OVERVIEW"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:orientation="vertical"
                android:background="@drawable/bg_pp_dashboard_income"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Γåæ  INCOME"
                    android:textColor="#16865B"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvTotalIncome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Γé╣0.00"
                    android:textColor="#126B49"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="21sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Money received"
                    android:textColor="#43866B"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:orientation="vertical"
                android:background="@drawable/bg_pp_dashboard_expense"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Γåô  EXPENSE"
                    android:textColor="#C64E5B"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvTotalExpense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Γé╣0.00"
                    android:textColor="#B94350"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="21sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Money spent"
                    android:textColor="#A96A70"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MONTHLY BUDGET"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_pp_dashboard_card"
            android:padding="14dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvMonthlyBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monthly Budget: Γé╣0.00"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvRemainingBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remaining Budget: Γé╣0.00"
                android:textColor="@color/income"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No transactions this month. Add your first transaction!"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_pp_dashboard_card"
            android:padding="12dp"
            android:layout_marginTop="7dp"
            android:visibility="visible"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUICK ACTIONS"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnAddTransaction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="∩╝ï  Add Transaction"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:background="@drawable/bg_pp_dashboard_button"
            android:stateListAnimator="@null"
            android:elevation="2dp"/>

        <Button
            android:id="@+id/btnTransactionHistory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:text="Transaction History"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/primary"
            android:backgroundTint="@color/primary_light"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/btnOpenBudget"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="10dp"
            android:text="Manage Monthly Budget"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/primary"
            android:backgroundTint="@color/primary_light"
            android:stateListAnimator="@null"/>

    </LinearLayout>
</ScrollView>


